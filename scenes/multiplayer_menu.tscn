[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/multiplayer_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://assets/sprites/background-day.png" id="2_bg"]
[ext_resource type="PackedScene" path="res://scenes/clouds.tscn" id="3_clouds"]
[ext_resource type="AudioStream" path="res://assets/audio/swoosh.ogg" id="4_swoosh"]

[node name="MultiplayerMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="Sprite2D" parent="."]
texture = ExtResource("2_bg")
centered = false

[node name="Clouds" parent="." instance=ExtResource("3_clouds")]

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.45)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -130.0
offset_top = -180.0
offset_right = 130.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 17
text = "👥 ÇOK OYUNCULU"
horizontal_alignment = 1

[node name="ProfileBar" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="PlayerNameLabel" type="Label" parent="Panel/VBox/ProfileBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 11
text = "👤 Oyuncu: ..."
horizontal_alignment = 1

[node name="EditNameBtn" type="Button" parent="Panel/VBox/ProfileBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 9
text = "✏️ Değiştir"

[node name="MainSelection" type="VBoxContainer" parent="Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1

[node name="DescLabel" type="Label" parent="Panel/VBox/MainSelection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 0.8)
theme_override_font_sizes/font_size = 10
text = "Nasıl oynamak istersin?"
horizontal_alignment = 1

[node name="LocalVersusBtn" type="Button" parent="Panel/VBox/MainSelection"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "📱 AYNI CİHAZDA 1v1\n(İnternetsiz / Yan Yana)"

[node name="OnlineBtn" type="Button" parent="Panel/VBox/MainSelection"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "🌐 ONLİNE / LAN (WIFI)\n(Farklı Telefon / PC)"

[node name="RaceBtn" type="Button" parent="Panel/VBox/MainSelection"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "🏃 STICKMAN YARIŞI (Botlara Karşı)"

[node name="BackBtn" type="Button" parent="Panel/VBox/MainSelection"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "🔙 ANA MENÜYE DÖN"

[node name="OnlineLobby" type="VBoxContainer" parent="Panel/VBox"]
visible = false
layout_mode = 2
theme_override_constants/separation = 10

[node name="ServerStatusLabel" type="Label" parent="Panel/VBox/OnlineLobby"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "🟢 Sunucuya Bağlandı"
horizontal_alignment = 1

[node name="TabBox" type="HBoxContainer" parent="Panel/VBox/OnlineLobby"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="HostTabBtn" type="Button" parent="Panel/VBox/OnlineLobby/TabBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "🏠 ODA KUR"

[node name="JoinTabBtn" type="Button" parent="Panel/VBox/OnlineLobby/TabBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "🔑 ODAYA KATIL"

[node name="HostSection" type="VBoxContainer" parent="Panel/VBox/OnlineLobby"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="RoomCodeLabel" type="Label" parent="Panel/VBox/OnlineLobby/HostSection"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.2, 1)
theme_override_font_sizes/font_size = 16
text = "ODA KODU: ----"
horizontal_alignment = 1

[node name="HostStatusLabel" type="Label" parent="Panel/VBox/OnlineLobby/HostSection"]
custom_minimum_size = Vector2(200, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "⏳ Sunucudan oda kodu alınıyor..."
horizontal_alignment = 1
autowrap_mode = 2

[node name="JoinSection" type="VBoxContainer" parent="Panel/VBox/OnlineLobby"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="CodeInput" type="LineEdit" parent="Panel/VBox/OnlineLobby/JoinSection"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
placeholder_text = "4 Haneli Oda Kodu"
alignment = 1
max_length = 6

[node name="JoinBtn" type="Button" parent="Panel/VBox/OnlineLobby/JoinSection"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "🚀 ODAYA KATIL"

[node name="JoinStatusLabel" type="Label" parent="Panel/VBox/OnlineLobby/JoinSection"]
custom_minimum_size = Vector2(200, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "Arkadaşının verdiği 4 haneli kodu gir."
horizontal_alignment = 1
autowrap_mode = 2

[node name="BackToSelBtn" type="Button" parent="Panel/VBox/OnlineLobby"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "🔙 GERİ"

[node name="SwooshPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_swoosh")

[node name="NameModal" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="NameModal"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)

[node name="Card" type="PanelContainer" parent="NameModal"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -115.0
offset_top = -145.0
offset_right = 115.0
offset_bottom = 145.0
