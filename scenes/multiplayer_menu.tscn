[connection signal="pressed" from="Panel/VBox/ProfileBar/EditNameBtn" to="." method="_on_edit_name_pressed"]
[connection signal="pressed" from="Panel/VBox/MainSelection/LocalVersusBtn" to="." method="_on_local_versus_pressed"]
[connection signal="pressed" from="Panel/VBox/MainSelection/OnlineBtn" to="." method="_on_online_menu_pressed"]
[connection signal="pressed" from="Panel/VBox/MainSelection/RaceBtn" to="." method="_on_stickman_race_pressed"]
[connection signal="pressed" from="Panel/VBox/MainSelection/BackBtn" to="." method="_on_back_to_main_pressed"]
[connection signal="pressed" from="Panel/VBox/OnlineLobby/TabBox/HostTabBtn" to="." method="_on_host_tab_pressed"]
[connection signal="pressed" from="Panel/VBox/OnlineLobby/TabBox/JoinTabBtn" to="." method="_on_join_tab_pressed"]
